{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "./.tsbuildinfo/build.tsbuildinfo",
    // Reset the `types: ["node"]` the typecheck config needs for tests: this
    // package is pure (no IO/DOM/React), so the build must fail if a non-test
    // src file reaches for Node globals or `node:*` modules.
    "types": []
  },
  "references": [
    { "path": "../topology-model/tsconfig.build.json" },
    { "path": "../topology-schema/tsconfig.build.json" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
