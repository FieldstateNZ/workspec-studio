exports[`renderDiagramToSvg > renders the pinned system-context diagram to valid, self-contained SVG 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" viewBox="40 -23 1012 383" role="img" aria-label="System Context"><title>System Context</title><defs><marker id="c4-arrow-4A90D9" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8 Z" fill="#4A90D9"/></marker><marker id="c4-arrow-4CAF50" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8 Z" fill="#4CAF50"/></marker></defs><rect x="40" y="-23" width="1012" height="383" fill="#fafafb"/><g><g aria-label="architect to main-system: designs systems in"><path d="M 200 220 L 300 220" fill="none" stroke="#4A90D9" stroke-width="1.5" marker-end="url(#c4-arrow-4A90D9)"/><text x="250" y="216" font-size="11" text-anchor="middle">designs systems in</text></g><g aria-label="main-system to payment-gateway: settles invoices via"><path d="M 700 255 L 703 255 Q 706 255 706 243 L 706 84 Q 706 72 709 72 L 712 72" fill="none" stroke="#4CAF50" stroke-width="1.5" marker-end="url(#c4-arrow-4CAF50)"/><text x="706" y="159.5" font-size="11" text-anchor="middle">settles invoices via</text></g></g><g><g aria-label="actor: Architect"><rect x="80" y="200" width="240" height="120" rx="10" ry="10" fill="#eff5fc" stroke="rgba(74, 144, 217, 0.28)" stroke-width="1"/><line x1="82" y1="200" x2="82" y2="320" stroke="#4a90d9" stroke-width="4"/><text x="94" y="226" font-size="14" font-weight="600" fill="#0a0a0c">Architect</text><text x="94" y="250" font-size="11" fill="rgba(10, 10, 12, 0.6)">Designs systems in WorkSpec and r…</text><text x="310" y="308" font-size="10" text-anchor="end" fill="#376494">actor</text></g><g aria-label="system: Fieldstate Ledger"><rect x="400" y="200" width="300" height="110" rx="10" ry="10" fill="#eaf1fa" stroke="rgba(17, 104, 189, 0.28)" stroke-width="1"/><line x1="402" y1="200" x2="402" y2="310" stroke="#1168bd" stroke-width="4"/><text x="414" y="226" font-s