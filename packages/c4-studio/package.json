{
  "name": "@workspec/c4-studio",
  "version": "0.1.0-alpha.5",
  "description": "WorkSpec C4 Studio — standalone CLI (validate, render, serve) and localhost host shell for browsing, validating, and rendering C4 architecture trees from a working directory's .workspec/ files.",
  "keywords": [
    "c4",
    "architecture",
    "diagrams",
    "yaml",
    "cli"
  ],
  "homepage": "https://github.com/FieldstateNZ/workspec-studio/tree/main/packages/c4-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FieldstateNZ/workspec-studio.git",
    "directory": "packages/c4-studio"
  },
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "workspec-c4": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo/build.tsbuildinfo && tsc -p tsconfig.build.json --emitDeclarationOnly && tsup && vite build",
    "build:client": "vite build",
    "dev": "vite build && tsx src/bin.ts serve --dir ../.. --port 4174",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "render:dogfood": "tsx src/bin.ts render system-context --dir ../.. --out ../../docs/c4/studio-system-context.svg && tsx src/bin.ts render container --dir ../.. --out ../../docs/c4/studio-container.svg"
  },
  "dependencies": {
    "@workspec/c4-layout": "workspace:^",
    "@workspec/c4-model": "workspace:^",
    "@workspec/c4-schema": "workspace:^",
    "@workspec/c4-ui": "workspace:^",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/expect": "4.1.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
