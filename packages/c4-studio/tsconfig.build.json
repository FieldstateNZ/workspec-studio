{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "./.tsbuildinfo/build.tsbuildinfo"
  },
  // Only `src` (the published library + bin entry) needs declarations; `client`
  // is a browser bundle built separately by Vite, not part of the public API.
  "references": [
    { "path": "../c4-schema/tsconfig.build.json" },
    { "path": "../c4-model/tsconfig.build.json" },
    { "path": "../c4-layout/tsconfig.build.json" },
    { "path": "../c4-ui/tsconfig.build.json" },
    { "path": "../mcp-core/tsconfig.build.json" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
