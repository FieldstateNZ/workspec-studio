{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "./.tsbuildinfo/build.tsbuildinfo",
    // Reset the `types: ["node"]` the typecheck config needs for tests: the
    // published surface is browser-safe, so the build must fail if a non-test
    // src file reaches for Node globals or `node:*` modules.
    "types": []
  },
  "references": [{ "path": "../cost-schema/tsconfig.build.json" }],
  "include": ["src/**/*.ts"],
  // demo-estate.fixture.ts is fixture-authoring data for the golden test /
  // gen script, not published engine surface — same shadow-emit split as
  // *.test.ts.
  "exclude": ["src/**/*.test.ts", "src/demo-estate.fixture.ts"]
}
