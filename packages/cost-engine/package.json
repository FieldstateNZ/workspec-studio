{
  "name": "@workspec/cost-engine",
  "version": "0.1.0-alpha.5",
  "description": "Pure, normative cost attribution engine for WorkSpec Cost Attribution. No IO, no DOM, no React.",
  "keywords": [
    "cost-attribution",
    "pure-function",
    "engine"
  ],
  "homepage": "https://github.com/FieldstateNZ/workspec-studio/tree/main/packages/cost-engine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FieldstateNZ/workspec-studio.git",
    "directory": "packages/cost-engine"
  },
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo/build.tsbuildinfo && tsc -p tsconfig.build.json --emitDeclarationOnly && tsup",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "gen:fixtures": "tsx scripts/gen-demo-fixtures.ts"
  },
  "dependencies": {
    "@workspec/cost-schema": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "fast-check": "^3.23.1",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
