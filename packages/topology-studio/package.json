{
  "name": "@workspec/topology-studio",
  "version": "0.1.0-alpha.1",
  "description": "WorkSpec Topology Studio — standalone CLI + localhost host shell. workspec-topology authors/validates/imports/reconciles/costs an infrastructure topology as YAML artifacts in your working tree.",
  "keywords": [
    "topology",
    "infrastructure",
    "architecture",
    "cost-modelling",
    "reconciliation",
    "yaml",
    "cli"
  ],
  "homepage": "https://github.com/FieldstateNZ/workspec-studio/tree/main/packages/topology-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FieldstateNZ/workspec-studio.git",
    "directory": "packages/topology-studio"
  },
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "workspec-topology": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo/build.tsbuildinfo && tsc -p tsconfig.build.json --emitDeclarationOnly && tsup && vite build",
    "build:client": "vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@workspec/decision-schema": "workspace:*",
    "@workspec/design": "0.1.0-alpha.1",
    "@workspec/mcp-core": "workspace:*",
    "@workspec/schema-core": "workspace:*",
    "@workspec/topology-adapters": "workspace:*",
    "@workspec/topology-cost": "workspace:*",
    "@workspec/topology-model": "workspace:*",
    "@workspec/topology-recon": "workspace:*",
    "@workspec/topology-schema": "workspace:*",
    "@workspec/topology-ui": "workspace:*",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
