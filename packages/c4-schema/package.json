{
  "name": "@workspec/c4-schema",
  "version": "0.1.0-alpha.0",
  "description": "Zod source of truth for WorkSpec C4 diagram artifacts — element/diagram/style/layout schemas, YAML parsing with line-mapped errors, and generated JSON Schema.",
  "keywords": ["zod", "json-schema", "yaml", "c4", "architecture", "diagrams", "schema"],
  "homepage": "https://github.com/FieldstateNZ/workspec-studio/tree/main/packages/c4-schema#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FieldstateNZ/workspec-studio.git",
    "directory": "packages/c4-schema"
  },
  "license": "Apache-2.0",
  "type": "module",
  "files": ["dist", "json-schema", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./json-schema/*": "./json-schema/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo/build.tsbuildinfo && tsc -p tsconfig.build.json --emitDeclarationOnly && tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "gen:schema": "tsx scripts/gen-schema.ts"
  }
}
