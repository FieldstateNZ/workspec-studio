{
  "name": "@workspec/cost-ui",
  "version": "0.1.0-alpha.0",
  "description": "Host-agnostic React views for WorkSpec Cost Attribution: the 2a unified Attribution Workbench, Inventory, Reports, and Tag-Plan review, composed by CostApp and themed via a `theme` prop — no host framework or CSS assumptions baked in.",
  "keywords": [
    "react",
    "cost-attribution",
    "finops",
    "ui",
    "components"
  ],
  "homepage": "https://github.com/FieldstateNZ/workspec-studio/tree/main/packages/cost-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FieldstateNZ/workspec-studio.git",
    "directory": "packages/cost-ui"
  },
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo/build.tsbuildinfo && tsc -p tsconfig.build.json --emitDeclarationOnly && tsup && tailwindcss --input src/index.css --output dist/styles.css --minify",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "dependencies": {
    "@workspec/cost-engine": "workspace:^",
    "@workspec/cost-schema": "workspace:^",
    "@workspec/design": "0.1.0-alpha.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.14",
    "@tanstack/react-query": "^5.62.7",
    "@vitest/expect": "4.1.10",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.14",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
