{
  "name": "@workspec/cost-studio",
  "version": "0.1.0-alpha.6",
  "description": "WorkSpec Cost Attribution — standalone CLI + localhost host shell. workspec-cost stocktakes a cloud estate, validates/reports on cost artifacts, and computes/applies tag plans.",
  "keywords": [
    "cost-attribution",
    "cli"
  ],
  "homepage": "https://github.com/FieldstateNZ/workspec-studio/tree/main/packages/cost-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FieldstateNZ/workspec-studio.git",
    "directory": "packages/cost-studio"
  },
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "workspec-cost": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo/build.tsbuildinfo && tsc -p tsconfig.build.json --emitDeclarationOnly && tsup && vite build",
    "build:client": "vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@workspec/cost-engine": "workspace:^",
    "@workspec/cost-provider": "workspace:^",
    "@workspec/cost-provider-azure": "workspace:^",
    "@workspec/cost-schema": "workspace:^",
    "@workspec/cost-ui": "workspace:^",
    "@workspec/design": "0.1.0-alpha.1",
    "@workspec/schema-core": "workspace:^",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@tanstack/react-query": "^5.62.7",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.10",
    "yaml": "^2.6.0"
  }
}
