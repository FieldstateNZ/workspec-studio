{
  "name": "@workspec/mcp-core",
  "version": "0.1.0-alpha.5",
  "description": "Shared MCP plumbing for WorkSpec Studio — assembling a low-level MCP Server from namespaced tool providers, mounting it stateless over Express, and running it over stdio. Zero domain knowledge, zero zod: tools advertise raw JSON Schema and self-validate their own arguments.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "json-schema",
    "workspec"
  ],
  "homepage": "https://github.com/FieldstateNZ/workspec-studio/tree/main/packages/mcp-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FieldstateNZ/workspec-studio.git",
    "directory": "packages/mcp-core"
  },
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo/build.tsbuildinfo && tsc -p tsconfig.build.json --emitDeclarationOnly && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
