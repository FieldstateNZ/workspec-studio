{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Deliberately NOT "dist": this config covers `dev/` alongside `src/`
    // (the standalone dev-story entry, T5's design-review story) and
    // includes test files, so a `tsc -b` typecheck of it would emit into a
    // tree that doesn't match `dist/`'s flat layout. Routing the typecheck
    // emit to a gitignored `.typecheck/` (never read by anything) keeps
    // `tsc -b`'s self-bootstrap working without polluting `dist/` — same
    // shadow-emit split as packages/cost-ui and packages/cost-studio.
    "outDir": ".typecheck",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "tsBuildInfoFile": "./.tsbuildinfo/typecheck.tsbuildinfo"
  },
  // TS Project References: let `tsc -b` type-check against the sibling
  // packages' real TypeScript source (building their declarations on
  // demand). Points at the siblings' *build* configs — only those emit to
  // the `dist/` layout their package.json "types" fields advertise, which is
  // what lets tsc map the imports back to source. Mirrors packages/cost-ui's
  // `references` pattern (T0's skeleton had none — this is where they land,
  // per that config's own doc comment).
  "references": [
    { "path": "../trace-model/tsconfig.build.json" },
    { "path": "../req-schema/tsconfig.build.json" }
  ],
  "include": ["src", "dev"]
}
