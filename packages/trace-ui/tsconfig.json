{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    // Deliberately NOT "dist": this config includes the test files, so a
    // `tsc -b` typecheck of it would emit *.test.d.ts into the published
    // tree (`files: ["dist"]` ships everything under dist/ in the npm
    // tarball). Routing the typecheck emit to a gitignored `.typecheck/`
    // (never read by anything) keeps `tsc -b`'s self-bootstrap working
    // without polluting `dist/` — same shadow-emit split as packages/cost-ui.
    "outDir": ".typecheck",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "tsBuildInfoFile": "./.tsbuildinfo/typecheck.tsbuildinfo"
  },
  // No TS Project References yet: this T0 skeleton has no `@workspec`
  // sibling dependency (no `@workspec/req-schema`/`trace-model` import) and
  // no `@workspec/design` dependency either — both land with the real views
  // starting T5 (mirrors packages/cost-ui's `references` pattern, which
  // will be added at that point).
  "include": ["src"]
}
