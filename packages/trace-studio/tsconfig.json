{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Deliberately NOT "dist": this config includes the test files, so a
    // `tsc -b` typecheck of it would emit *.test.d.ts into the published
    // tree (`files: ["dist"]` ships everything under dist/ in the npm
    // tarball). Routing the typecheck emit to a gitignored `.typecheck/`
    // (never read by anything) keeps `tsc -b`'s self-bootstrap working
    // without polluting `dist/` — same shadow-emit split as
    // packages/cost-studio.
    "rootDir": "src",
    "outDir": ".typecheck",
    "tsBuildInfoFile": "./.tsbuildinfo/typecheck.tsbuildinfo",
    // This IS a Node CLI (bin.ts/cli.ts touch `process`, fs-repository.ts
    // imports `node:*`) — so node globals/types are EXPECTED here, unlike the
    // pure sibling packages (trace-model/trace-emitters pin `types: []`). Set
    // explicitly rather than relying on automatic `@types/*` discovery, which
    // under this repo's pinned typescript@^6 + @types/node@^24 does not resolve
    // `process`/`node:*` for this package without it.
    "types": ["node"]
  },
  // TS Project References: let `tsc -b` type-check against the sibling
  // packages' real TypeScript source (building their declarations on demand),
  // so `typecheck` never has to run after `build` — matching CI, which
  // typechecks BEFORE any dist/ exists. Points at each dependency's *build*
  // config (rootDir "src", the published dist/ layout the package.json "types"
  // field advertises). trace-studio imports all four directly.
  "references": [
    { "path": "../schema-core/tsconfig.build.json" },
    { "path": "../req-schema/tsconfig.build.json" },
    { "path": "../trace-model/tsconfig.build.json" },
    { "path": "../trace-emitters/tsconfig.build.json" }
  ],
  "include": ["src"]
}
