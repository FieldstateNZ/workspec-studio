{
  "name": "@workspec/c4-ui",
  "version": "0.1.0-alpha.5",
  "description": "Host-agnostic React components for interactive WorkSpec C4 diagrams (standalone lib + module-federation remote).",
  "keywords": [
    "react",
    "module-federation",
    "c4",
    "architecture",
    "diagrams",
    "ui"
  ],
  "homepage": "https://github.com/FieldstateNZ/workspec-studio/tree/main/packages/c4-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FieldstateNZ/workspec-studio.git",
    "directory": "packages/c4-ui"
  },
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo/build.tsbuildinfo && tsc -p tsconfig.build.json --emitDeclarationOnly && tsup && tailwindcss --input src/index.css --output dist/styles.css --minify",
    "build:mf": "vite build --config vite.config.mf.ts",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "@workspec/c4-schema": "workspace:*",
    "@workspec/c4-model": "workspace:*",
    "@workspec/c4-layout": "workspace:*",
    "@workspec/canvas": "workspace:*",
    "@workspec/canvas-c4": "workspace:*",
    "@workspec/design": "0.1.0-alpha.1",
    "lucide-react": "^0.545.0"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.16.12",
    "@tailwindcss/cli": "^4.1.14",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@vitest/expect": "4.1.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.14",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
