{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    // Deliberately NOT "dist": this config includes the test files, so a
    // `tsc -b` typecheck of it would emit *.test.d.ts into the published
    // tree (`files: ["dist"]` ships everything under dist/ in the npm
    // tarball). Routing the typecheck emit to a gitignored `.typecheck/`
    // (never read by anything) keeps `tsc -b`'s self-bootstrap working
    // without polluting `dist/` — same shadow-emit split as packages/cost-*.
    "outDir": ".typecheck",
    "tsBuildInfoFile": "./.tsbuildinfo/typecheck.tsbuildinfo",
    // This is a PURE engine: no `node:*` imports, no Node globals — in src OR
    // in tests (the golden fixtures are constructed in TypeScript, not loaded
    // from disk). Pin `types: []` so a stray Node dependency fails the
    // typecheck instead of silently compiling.
    "types": []
  },
  // TS Project Reference: lets `tsc -b` type-check against req-schema's real
  // TypeScript source (building its declarations on demand, and schema-core's
  // transitively — req-schema already references it), so `typecheck` never has
  // to run after `build`. Points at the sibling's *build* config (rootDir
  // "src", matching the published layout), not its default tsconfig.json. Same
  // pattern as packages/c4-model and packages/req-schema.
  "references": [{ "path": "../req-schema/tsconfig.build.json" }],
  "include": ["src"]
}
