{
  "name": "@workspec/cost-provider",
  "version": "0.1.0-alpha.0",
  "description": "Pluggable cost-data provider contract for WorkSpec Cost Attribution. C0 bootstrap: package identity export only — the provider port lands in a later slice.",
  "keywords": [
    "cost-attribution",
    "provider",
    "port"
  ],
  "homepage": "https://github.com/FieldstateNZ/workspec-studio/tree/main/packages/cost-provider#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FieldstateNZ/workspec-studio.git",
    "directory": "packages/cost-provider"
  },
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo/build.tsbuildinfo && tsc -p tsconfig.build.json --emitDeclarationOnly && tsup",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@workspec/cost-schema": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
