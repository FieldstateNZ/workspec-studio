{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    // Deliberately NOT "dist": this config includes the test files, so a
    // `tsc -b` typecheck of it would emit *.test.d.ts into the published
    // tree (`files: ["dist"]` ships everything under dist/ in the npm
    // tarball). Routing the typecheck emit to a gitignored `.typecheck/`
    // (never read by anything) keeps `tsc -b`'s self-bootstrap working
    // without polluting `dist/` — same shadow-emit split as packages/c4-*.
    "outDir": ".typecheck",
    "tsBuildInfoFile": "./.tsbuildinfo/typecheck.tsbuildinfo",
    // Explicit, rather than relying on TypeScript's automatic `@types/*`
    // discovery: under this package's pinned `typescript@^6.0.3` +
    // `@types/node@^24`, automatic discovery of the global `node:fs`-style
    // ambient module declarations does not kick in — needed here because
    // `src/browser-safety.test.ts` reaches for `node:fs`/`node:path`/etc to
    // statically scan this package's own source graph (same pattern as
    // packages/cost-schema and packages/c4-model).
    "types": ["node"]
  },
  // TS Project Reference: lets `tsc -b` type-check against cost-schema's real
  // TypeScript source (building its declarations on demand), so `typecheck`
  // never has to run after `build`. Points at the sibling's *build* config,
  // not its default tsconfig.json: only the build config's outDir ("dist")
  // matches the `dist/index.d.ts` its package.json "types" field advertises,
  // which is what lets tsc map the import back to source.
  "references": [{ "path": "../cost-schema/tsconfig.build.json" }],
  "include": ["src"]
}
