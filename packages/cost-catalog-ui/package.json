  "dependencies": { "@workspec/cost-catalog": "workspace:*", "lucide-react": "^0.577.0", "react": "^18.3.1" },
  "devDependencies": { "@types/react": "^18.3.28", "tsup": "^8.5.1", "typescript": "^6.0.3", "vitest": "^4.1.10" },
  "peerDependencies": { "react": "^18.3.1" }
}
