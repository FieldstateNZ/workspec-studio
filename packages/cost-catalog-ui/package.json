{
  "name": "@workspec/cost-catalog-ui",
  "version": "0.1.0-alpha.1",
  "description": "Reusable Enterprise-style editors for WorkSpec cost catalogs.",
  "license": "Apache-2.0",
  "type": "module",
  "files": ["dist", "README.md", "LICENSE"],
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" }, "./styles.css": "./dist/styles.css" },
