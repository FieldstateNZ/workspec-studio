{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    // Deliberately NOT "dist": this config includes the test files, so a
    // `tsc -b` typecheck of it would emit *.test.d.ts into the published
    // tree (`files: ["dist"]` ships everything under dist/ in the npm
    // tarball). Routing the typecheck emit to a gitignored `.typecheck/`
    // (never read by anything) keeps `tsc -b`'s self-bootstrap working
    // without polluting `dist/` — same shadow-emit split as packages/c4-*.
    "outDir": ".typecheck",
    "tsBuildInfoFile": "./.tsbuildinfo/typecheck.tsbuildinfo",
    // Explicit, rather than relying on TypeScript's automatic `@types/*`
    // discovery: under this package's pinned `typescript@^6.0.3` +
    // `@types/node@^24`, automatic discovery of the global `node:fs`-style
    // ambient module declarations does not kick in (verified: the same
    // sources typecheck cleanly under typescript@5.9.x, or with this `types`
    // array set explicitly). decision-schema doesn't need this because it is
    // still pinned to typescript@^5.7.
    "types": ["node"]
  },
  "include": ["src"]
}
