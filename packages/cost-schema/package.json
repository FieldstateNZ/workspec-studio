{
  "name": "@workspec/cost-schema",
  "version": "0.1.0-alpha.0",
  "description": "Zod source of truth for WorkSpec Cost Attribution artifacts (pricing catalogs, usage records, allocation rules). C0 bootstrap: package identity export only — the real schemas land in a later slice.",
  "keywords": [
    "zod",
    "schema",
    "cost-attribution"
  ],
  "homepage": "https://github.com/FieldstateNZ/workspec-studio/tree/main/packages/cost-schema#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FieldstateNZ/workspec-studio.git",
    "directory": "packages/cost-schema"
  },
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo/build.tsbuildinfo && tsc -p tsconfig.build.json --emitDeclarationOnly && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
