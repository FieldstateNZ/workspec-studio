{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "./.tsbuildinfo/build.tsbuildinfo",
    // Already `[]` in the base typecheck config; restated here so the published
    // surface's browser-safe, no-Node contract is explicit at the build step.
    "types": []
  },
  "references": [
    { "path": "../req-schema/tsconfig.build.json" },
    { "path": "../trace-model/tsconfig.build.json" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
