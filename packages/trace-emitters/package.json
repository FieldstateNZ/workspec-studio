{
  "name": "@workspec/trace-emitters",
  "version": "0.1.0-alpha.5",
  "description": "Pure emit/ingest functions for the WorkSpec Traceability Workbench's test-framework emitters — each a named convention binding SysReq artifacts to a test toolchain in both directions. Ships the `cucumber` (emit → .feature files) and `junit` (emit → JUnit XML files) emitters, both ingest → TestRun, and a shared round-trip conformance harness. No IO, no DOM, no React.",
  "keywords": [
    "traceability",
    "pure-function",
    "cucumber",
    "junit",
    "emitter"
  ],
  "homepage": "https://github.com/FieldstateNZ/workspec-studio/tree/main/packages/trace-emitters#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FieldstateNZ/workspec-studio.git",
    "directory": "packages/trace-emitters"
  },
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo/build.tsbuildinfo && tsc -p tsconfig.build.json --emitDeclarationOnly && tsup",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@workspec/req-schema": "workspace:*",
    "@workspec/trace-model": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
