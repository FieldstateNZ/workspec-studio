{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    // Deliberately NOT "dist": this config includes the test files, so a
    // `tsc -b` typecheck of it would emit *.test.d.ts into the published
    // tree (`files: ["dist"]` ships everything under dist/ in the npm
    // tarball). Routing the typecheck emit to a gitignored `.typecheck/`
    // (never read by anything) keeps `tsc -b`'s self-bootstrap working
    // without polluting `dist/` — same shadow-emit split as packages/c4-*
    // and packages/decision-ui.
    "outDir": ".typecheck",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "tsBuildInfoFile": "./.tsbuildinfo/typecheck.tsbuildinfo",
    // Only `src/test-helpers/read-web-app-fixture.ts` (test-only, reads a
    // fixture off disk) needs Node's ambient types; the published surface
    // stays browser-safe (`tsconfig.build.json` resets this to `[]`), same
    // split as packages/topology-schema.
    "types": ["node"]
  },
  // TS Project References: let `tsc -b` type-check against the sibling
  // packages' real TypeScript source (building their declarations on
  // demand), so `typecheck` never has to run after `build`. Points at the
  // siblings' *build* configs — only those emit to the `dist/` layout their
  // package.json "types" fields advertise, which is what lets tsc map the
  // imports back to source.
  "references": [
    { "path": "../topology-model/tsconfig.build.json" },
    { "path": "../topology-schema/tsconfig.build.json" },
    { "path": "../topology-recon/tsconfig.build.json" },
    { "path": "../topology-cost/tsconfig.build.json" },
    { "path": "../decision-schema/tsconfig.build.json" },
    { "path": "../topology-planning/tsconfig.build.json" }
  ],
  "include": ["src"]
}
