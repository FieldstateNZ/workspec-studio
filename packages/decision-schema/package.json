{
  "name": "@workspec/decision-schema",
  "version": "0.1.0-alpha.6",
  "description": "Zod source of truth for WorkSpec Decision Studio artifacts — TS types, runtime validation, and generated JSON Schema.",
  "keywords": [
    "zod",
    "json-schema",
    "yaml",
    "architecture-decision-records",
    "schema"
  ],
  "homepage": "https://github.com/FieldstateNZ/workspec-studio/tree/main/packages/decision-schema#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FieldstateNZ/workspec-studio.git",
    "directory": "packages/decision-schema"
  },
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo/build.tsbuildinfo && tsc -p tsconfig.build.json --emitDeclarationOnly && tsup",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "gen:schema": "tsx scripts/gen-json-schema.ts"
  },
  "dependencies": {
    "@workspec/schema-core": "workspace:*",
    "yaml": "^2.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
