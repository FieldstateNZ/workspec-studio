{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    // Deliberately NOT "dist": this config includes the test files, so a
    // `tsc -b` typecheck of it would emit *.test.d.ts into the published
    // tree (`files: ["dist"]` ships everything under dist/ in the npm
    // tarball). Routing the typecheck emit to a gitignored `.typecheck/`
    // (never read by anything) keeps `tsc -b`'s self-bootstrap working
    // without polluting `dist/` — same shadow-emit split as
    // packages/topology-ui and packages/c4-*.
    "outDir": ".typecheck",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "tsBuildInfoFile": "./.tsbuildinfo/typecheck.tsbuildinfo",
    // Only the source-contract tests (the zero-local-tokens grep reads the
    // package's own source with node:fs) need Node's ambient types; the
    // published surface stays browser-safe (`tsconfig.build.json` resets
    // this to `[]`), same split as packages/canvas.
    "types": ["node"]
  },
  // TS Project References: type-check against the siblings' real source
  // (building their declarations on demand) — mirrors packages/c4-ui.
  "references": [
    { "path": "../c4-schema/tsconfig.build.json" },
    { "path": "../c4-model/tsconfig.build.json" },
    { "path": "../c4-layout/tsconfig.build.json" },
    { "path": "../canvas/tsconfig.build.json" }
  ],
  "include": ["src"]
}
