  "description": "Provider-agnostic cost catalog schemas and deterministic solution-option pricing for WorkSpec.",
  "license": "Apache-2.0",
  "type": "module",
  "files": ["dist", "README.md", "LICENSE"],
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" } },
