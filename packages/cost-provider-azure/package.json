{
  "name": "@workspec/cost-provider-azure",
  "version": "0.1.0-alpha.0",
  "description": "Azure Cost Management implementation of the WorkSpec Cost Attribution provider contract — Resource Graph inventory, Cost Management spend, ARM tag apply, and drift verification, over plain REST.",
  "keywords": [
    "cost-attribution",
    "provider",
    "azure"
  ],
  "homepage": "https://github.com/FieldstateNZ/workspec-studio/tree/main/packages/cost-provider-azure#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FieldstateNZ/workspec-studio.git",
    "directory": "packages/cost-provider-azure"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo/build.tsbuildinfo && tsc -p tsconfig.build.json --emitDeclarationOnly && tsup",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "live-check": "tsx scripts/live-check.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@workspec/cost-provider": "workspace:^",
    "@workspec/cost-schema": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
