{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    // Deliberately NOT "dist": this config's rootDir is "." (it covers
    // top-level `test/` alongside `src/`, unlike `tsconfig.build.json`),
    // so a `tsc -b` build of it emits `<outDir>/src/*.d.ts` +
    // `<outDir>/test/*.d.ts` (mirroring the "." root), not the flat
    // `<outDir>/*.d.ts` layout `tsconfig.build.json` and package.json's
    // "types" field expect. Routing that emit to a top-level gitignored
    // `.typecheck/` (never read by anything) keeps `tsc -b`'s
    // self-bootstrap working for typecheck without ever touching the
    // published `dist/` tree — `files: ["dist"]` means anything under
    // dist/ ships in the npm tarball, so the shadow emit must live OUTSIDE
    // it. See the sibling comment on `references` for why c4-schema needed
    // the same distinction from the other side.
    "outDir": ".typecheck",
    "types": ["node"],
    "tsBuildInfoFile": "./.tsbuildinfo/typecheck.tsbuildinfo"
  },
  // TS Project Reference: lets `tsc -b` type-check against c4-schema's real
  // TypeScript source (building its declarations on demand), so `typecheck`
  // never has to run after `build`. Points at c4-schema's *build* config
  // rather than its default `tsconfig.json`: that package's own
  // `tsconfig.json` has `rootDir: "."` (it also typechecks `scripts/` and
  // `test/`, which live outside `src/`), so building it on demand via `-b`
  // emits to `dist/src/index.d.ts` — not the `dist/index.d.ts` its own
  // `package.json` "types" field points at. `tsconfig.build.json` has the
  // `rootDir: "src"` shape that actually matches the published layout.
  "references": [{ "path": "../c4-schema/tsconfig.build.json" }],
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
