{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    // Deliberately NOT "dist": this config includes the test files, so a
    // `tsc -b` typecheck of it would emit *.test.d.ts into the published
    // tree (`files: ["dist"]` ships everything under dist/ in the npm
    // tarball). Routing the typecheck emit to a gitignored `.typecheck/`
    // (never read by anything) keeps `tsc -b`'s self-bootstrap working
    // without polluting `dist/` — same shadow-emit split as
    // packages/topology-ui and packages/c4-*.
    "outDir": ".typecheck",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "tsBuildInfoFile": "./.tsbuildinfo/typecheck.tsbuildinfo",
    // Only the source-contract test (`src/viewport-seam.test.ts`, which greps
    // the package sources off disk for banned window/document globals) needs
    // Node's ambient types; the published surface stays browser-safe
    // (`tsconfig.build.json` resets this to `[]`), same split as
    // packages/topology-ui.
    "types": ["node"]
  },
  "include": ["src"]
}
