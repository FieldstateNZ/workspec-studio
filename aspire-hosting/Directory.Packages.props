<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Latest stable 13.x line as of 2026-07-14 (verified against nuget.org).
         Aspire.Hosting.Testing is pinned here for future slices (A1+ hosting
         integration tests via DistributedApplicationTestingBuilder) — A0's
         smoke test doesn't consume it yet. -->
    <PackageVersion Include="Aspire.Hosting" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.4.6" />
    <!-- aspire-hosting-e2e-fixture-apphost only: a real (if otherwise-empty) AppHost project,
         needed because DistributedApplicationTestingBuilder actually orchestrates via DCP — it
         requires the Aspire.AppHost.Sdk-wired DCP/dashboard binary paths, not just an
         Aspire.Hosting package reference (confirmed empirically; see that project's own comment). -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.4.6" />
    <!-- aspire-hosting-cost only (A5): the publish-time cost-estimate step walks the app model's
         Azure provisioning resources via Aspire.Hosting.Azure's AzureProvisioningResource —
         same 13.4.6 line as the rest of this solution's Aspire packages (verified against
         nuget.org). Aspire.Hosting.Azure.Storage is pinned for aspire-hosting-tests only, as the
         one concrete Azure resource type (AddAzureStorage) exercised by the publish-step tests;
         its own version line tracks Aspire.Hosting.Azure's (both 13.4.6 as of 2026-07-14). -->
    <PackageVersion Include="Aspire.Hosting.Azure" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="13.4.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- xunit test stack: matches what the locally installed .NET 10 SDK's
         own "xUnit Test Project" / "Aspire Test Project (xUnit)" templates
         generate (dotnet new xunit / dotnet new aspire-xunit) — classic
         xunit v2 + VSTest, not xunit.v3/Microsoft.Testing.Platform, is still
         the SDK's own default on .NET 10. -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

</Project>
