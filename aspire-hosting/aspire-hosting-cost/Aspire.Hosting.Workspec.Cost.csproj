<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Workspec.Aspire.Hosting.Cost</PackageId>
    <Description>Wires the workspec-cost CLI into a .NET Aspire apphost: Stocktake/Report/Validate dashboard commands over a directory of cost artifacts, plus a publish-time step that estimates Azure resource costs from the apphost's own provisioning resources.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
    <!-- Publish-time cost-estimate step only (WorkspecCostPublishEstimateExtensions) — reads
         AzureProvisioningResource.GetBicepTemplateString() to extract resource type/SKU. See
         docs/aspire-hosting/cost-integration.md for why this is the only viable read path. -->
    <PackageReference Include="Aspire.Hosting.Azure" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\aspire-hosting-core\Aspire.Hosting.Workspec.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
