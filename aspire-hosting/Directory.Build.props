<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Aspire.Hosting ships its integration analyzers as a buildTransitive asset
         gated behind this flag; the standalone "Aspire.Hosting.Integration.Analyzers"
         package publishes prerelease-only versions, so the bundled asset is the
         stable path — see aspire-hosting/README.md. -->
    <EnableAspireIntegrationAnalyzers>true</EnableAspireIntegrationAnalyzers>
  </PropertyGroup>

  <!-- Shared NuGet pack metadata (A6, #39). IsPackable defaults to false here — only the four
       shipping projects (Core/C4/Decisions/Cost) opt back in, in their own .csproj; everything else
       (tests, the E2E fixture apphost) stays IsPackable=false, matching what those projects already
       set explicitly. The "Aspire." PackageId prefix is reserved on nuget.org (owners: Microsoft,
       aspire — verified empirically at A6 time; see aspire-hosting/README.md's "NuGet publishing"
       section), so the four packable projects use a Workspec.Aspire.Hosting.* PackageId while their
       assembly names stay Aspire.Hosting.Workspec.* (decided in #39). -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Version>0.1.0-alpha.5</Version>
    <Authors>Fieldstate</Authors>
    <Company>Fieldstate</Company>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/FieldstateNZ/workspec-studio</PackageProjectUrl>
    <RepositoryUrl>https://github.com/FieldstateNZ/workspec-studio.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

</Project>
