{
  "$id": "https://schema.workspec.io/v1alpha1/attribution.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A WorkSpec attribution artifact: dimensions, ordered rules, and pinned overrides.",
  "properties": {
    "apiVersion": {
      "const": "workspec.io/v1alpha1",
      "description": "Artifact API version discriminant.",
      "type": "string"
    },
    "kind": {
      "const": "Attribution",
      "description": "Artifact kind discriminant.",
      "type": "string"
    },
    "metadata": {
      "description": "Common artifact identity.",
      "properties": {
        "slug": {
          "description": "Stable filename slug. Optional: the loader derives it from the artifact's filename under `.workspec/<kind-dir>/<slug>.yaml` when absent; when present it must already be a valid slug.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "spec": {
      "description": "The attribution body: optional name, dimensions, ordered rules, and pinned overrides.",
      "properties": {
        "dimensions": {
          "description": "Declared attribution dimensions (axes). Dimension ids must be unique.",
          "items": {
            "description": "An attribution dimension: a named axis of cost allocation.",
            "properties": {
              "id": {
                "description": "Stable dimension id, unique among dimensions, e.g. \"product\".",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
                "type": "string"
              },
              "label": {
                "description": "Human-readable dimension name, e.g. \"Product\".",
                "minLength": 1,
                "type": "string"
              },
              "values": {
                "description": "Declared value ids for this dimension, e.g. [\"atrium\", \"workspec\"]. Must be unique.",
                "items": {
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "id",
              "label",
              "values"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "name": {
          "description": "Optional human-readable name for this attribution.",
          "minLength": 1,
          "type": "string"
        },
        "overrides": {
          "description": "Pinned per-resource assignments that beat all rules (engine precedence — see README).",
          "items": {
            "description": "A pinned per-resource assignment that beats all rules.",
            "properties": {
              "assign": {
                "additionalProperties": {
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
                  "type": "string"
                },
                "description": "Pinned per-dimension value assignment; beats all rules (engine precedence — see README).",
                "propertyNames": {
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
                  "type": "string"
                },
                "type": "object"
              },
              "resourceId": {
                "description": "Resource id this override pins (matches an Inventory resource id).",
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "resourceId",
              "assign"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "rules": {
          "description": "Attribution rules. ORDERED: the order in the file IS the match precedence — the attribution engine (a later slice) applies the first matching rule, per dimension, independently. An empty `match: {}` matches every resource, so a catch-all rule belongs last.",
          "items": {
            "description": "An attribution rule: match conditions plus one or more effects.",
            "properties": {
              "assign": {
                "additionalProperties": {
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
                  "type": "string"
                },
                "description": "Literal per-dimension value assignment.",
                "propertyNames": {
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
                  "type": "string"
                },
                "type": "object"
              },
              "fromTag": {
                "additionalProperties": {
                  "minLength": 1,
                  "type": "string"
                },
                "description": "Per-dimension assignment read from a resource tag.",
                "propertyNames": {
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
                  "type": "string"
                },
                "type": "object"
              },
              "id": {
                "description": "Stable rule id, unique among rules, e.g. \"r1\".",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
                "type": "string"
              },
              "match": {
                "description": "Match conditions; ALL present fields must match (AND).",
                "properties": {
                  "nameGlob": {
                    "description": "Glob match on the Inventory resource `name` (`*` is the only wildcard).",
                    "minLength": 1,
                    "type": "string"
                  },
                  "resourceGroup": {
                    "description": "Glob match on the Inventory resource `resourceGroup` (`*` is the only wildcard).",
                    "minLength": 1,
                    "type": "string"
                  },
                  "resourceType": {
                    "description": "Exact match on the Inventory resource `type`.",
                    "minLength": 1,
                    "type": "string"
                  },
                  "subscription": {
                    "description": "Exact match on the Inventory resource `subscription`.",
                    "minLength": 1,
                    "type": "string"
                  },
                  "tagEquals": {
                    "description": "Match when the resource has this tag name set to this exact value.",
                    "properties": {
                      "name": {
                        "description": "Tag name.",
                        "minLength": 1,
                        "type": "string"
                      },
                      "value": {
                        "description": "Tag value to match exactly.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "value"
                    ],
                    "type": "object"
                  },
                  "tagExists": {
                    "description": "Match when the resource has this tag name set, regardless of value.",
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "name": {
                "description": "Human-readable rule name.",
                "minLength": 1,
                "type": "string"
              },
              "split": {
                "additionalProperties": {
                  "additionalProperties": {
                    "exclusiveMinimum": 0,
                    "type": "number"
                  },
                  "propertyNames": {
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
                    "type": "string"
                  },
                  "type": "object"
                },
                "description": "Per-dimension ratio splits across multiple values.",
                "propertyNames": {
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
                  "type": "string"
                },
                "type": "object"
              }
            },
            "required": [
              "id",
              "name",
              "match"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "dimensions",
        "rules"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "WorkSpec Attribution (v1alpha1)",
  "type": "object"
}
