{
  "$id": "https://schema.workspec.io/v1alpha1/environment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A WorkSpec environment artifact: naming conventions for one deployment environment.",
  "properties": {
    "apiVersion": {
      "const": "workspec.io/v1alpha1",
      "description": "Artifact API version discriminant.",
      "type": "string"
    },
    "kind": {
      "const": "Environment",
      "description": "Artifact kind discriminant.",
      "type": "string"
    },
    "metadata": {
      "description": "Common artifact identity.",
      "properties": {
        "slug": {
          "description": "Stable filename slug. Optional: the loader derives it from the artifact's filename under `.workspec/<kind-dir>/<slug>.yaml` when absent; when present it must already be a valid slug.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "spec": {
      "description": "The environment body: naming conventions.",
      "properties": {
        "naming": {
          "description": "Naming conventions for this environment.",
          "properties": {
            "resourceGroupSuffix": {
              "description": "Suffix appended to generated resource-group names in this environment.",
              "minLength": 1,
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata"
  ],
  "title": "WorkSpec Environment (v1alpha1)",
  "type": "object"
}
