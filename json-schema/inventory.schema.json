{
  "$id": "https://schema.workspec.io/v1alpha1/inventory.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A WorkSpec inventory artifact: a point-in-time resource stock-take.",
  "properties": {
    "apiVersion": {
      "const": "workspec.io/v1alpha1",
      "description": "Artifact API version discriminant.",
      "type": "string"
    },
    "kind": {
      "const": "Inventory",
      "description": "Artifact kind discriminant.",
      "type": "string"
    },
    "metadata": {
      "description": "Common artifact identity.",
      "properties": {
        "slug": {
          "description": "Stable filename slug. Optional: the loader derives it from the artifact's filename under `.workspec/<kind-dir>/<slug>.yaml` when absent; when present it must already be a valid slug.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "spec": {
      "description": "The inventory body: optional name, stock-take instant, scope, and resources.",
      "properties": {
        "asOf": {
          "description": "ISO 8601 UTC timestamp: the stock-take instant.",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
          "type": "string"
        },
        "name": {
          "description": "Optional human-readable name for this inventory.",
          "minLength": 1,
          "type": "string"
        },
        "resources": {
          "description": "Stock-taken resources. MUST be sorted ascending by `id` (plain JavaScript string comparison, i.e. UTF-16 code units) — this is what makes a plain `git diff` between two stock-takes the drift report.",
          "items": {
            "description": "A single stock-taken provider resource.",
            "properties": {
              "id": {
                "description": "Provider resource id, e.g. an Azure ARM resource id. Provider-neutral: any nonempty string. Unique across the file; resources are sorted ascending by this field (schema contract, see README).",
                "minLength": 1,
                "type": "string"
              },
              "location": {
                "description": "Provider region/location, e.g. \"australiaeast\".",
                "minLength": 1,
                "type": "string"
              },
              "name": {
                "description": "Resource display name.",
                "minLength": 1,
                "type": "string"
              },
              "resourceGroup": {
                "description": "Resource group name.",
                "minLength": 1,
                "type": "string"
              },
              "subscription": {
                "description": "Subscription id or name the resource belongs to.",
                "minLength": 1,
                "type": "string"
              },
              "tags": {
                "additionalProperties": {
                  "description": "A resource tag value: at most 256 characters. No character restriction.",
                  "maxLength": 256,
                  "type": "string"
                },
                "description": "Resource tags, keyed by tag name.",
                "propertyNames": {
                  "description": "A resource tag name: 1-512 characters, must not contain < > % & \\ ? / (Azure rule).",
                  "maxLength": 512,
                  "minLength": 1,
                  "pattern": "^[^<>%&\\\\?/]*$",
                  "type": "string"
                },
                "type": "object"
              },
              "type": {
                "description": "Provider resource type, e.g. \"Microsoft.Compute/virtualMachines\".",
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "type",
              "location",
              "resourceGroup",
              "subscription"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "scope": {
          "description": "What was stock-taken.",
          "properties": {
            "subscriptions": {
              "description": "Subscription ids/names covered by this stock-take.",
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "subscriptions"
          ],
          "type": "object"
        }
      },
      "required": [
        "asOf",
        "scope",
        "resources"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "WorkSpec Inventory (v1alpha1)",
  "type": "object"
}
