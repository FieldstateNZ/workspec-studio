@@ -0,0 +1,93 @@
+// S6 SPIKE DRAFT (#122, task 3) — DiagramDetailIn → ResolvedDiagram
+// adapter, so the enterprise wire model feeds the package's
+// `buildC4Shapes` unchanged. Verified against @workspec/canvas-c4:
+// `buildC4Shapes` reads only `resolved.view` / `resolved.lensViews` /
+// `resolved.type`; `projectC4Diagram` additionally reads
+// `resolved.layout?.data` — the enterprise skips that entrypoint entirely
+// (it keeps its dagre/saved-layout position authority and passes
+// `options.positions`), so `raw`/`layout` are inert here.
+//
+// Enterprise-host fields the studio model deliberately lacks
+// (`validationErrors`, `artifactRefId`) ride via the documented
+// `C4NodeMeta` post-pass below — the S3 field split (#119).
+
+import type { ResolvedDiagram } from '@workspec/c4-model';
+import {
+  buildC4Shapes,
+  type BuildC4ShapesOptions,
+  type C4NodeShape,
+  type ProjectionResult,
+} from '@workspec/canvas-c4';
+import type { Shape, ShapeId } from '@/canvas/types';
+import type { DiagramDetailIn, DiagramNodeIn } from './projectModel';
+
+/** Maps the enterprise diagram wire detail to the package's resolved-diagram input. */
+export function toResolvedDiagram(detail: DiagramDetailIn): ResolvedDiagram {
+  const nodes = (detail.diagram.nodes ?? []).map((n) => ({
+    nodeId: n.id,
+    slug: n.id,
+    kind: n.type,
+    title: n.label,
+    description: n.description ?? null,
+    technology: null,
+    tags: [] as readonly string[],
+    position: null,
+    injected: false,
+    dangling: false,
+  }));
+  const edges = (detail.diagram.edges ?? []).map((e) => ({
+    from: e.from,
+    to: e.to,
+    label: e.label ?? null,
+    category: e.category ?? null,
+    lens: e.lens ?? null,
+    dangling: false,
+  }));
+  return {
+    slug: '',
+    path: '',
+    title: '',
+    type: detail.diagram.type,
+    description: null,
+    // `raw` is required by the type but never read by the projection —
+    // PACKAGE GAP #3 in the adoption report proposes a dedicated input
+    // type (or making these fields optional) so hosts don't synthesise.
+    raw: { title: '', type: detail.diagram.type, nodes: [], edges: [] } as ResolvedDiagram['raw'],
+    view: { nodes, edges },
+    lensViews: null,
+    layout: null,
+  };
+}
+
+/**
+ * The enterprise projection entry point: adapter → package projection →
+ * host-meta post-pass. Signature mirrors the retired local `buildShapes`
+ * so `useC4Diagram`'s call sites change mechanically.
+ */
+export function buildEnterpriseC4Shapes(
+  detail: DiagramDetailIn,
+  options: BuildC4ShapesOptions,
+): ProjectionResult {
+  const result = buildC4Shapes(toResolvedDiagram(detail), options);
+
+  // Post-pass: layer the enterprise artifact data onto `meta` (the
+  // documented C4NodeMeta protocol — validity markers + element editor).
+  const byId = new Map<string, DiagramNodeIn>();
+  for (const n of detail.diagram.nodes ?? []) byId.set(n.id, n);
+  const shapes: Record<ShapeId, Shape> = { ...result.shapes };
+  for (const [id, shape] of Object.entries(shapes)) {
+    if (shape.type !== 'c4node') continue;
+    const node = shape as C4NodeShape;
+    const src = byId.get(node.slug);
+    if (!src) continue;
+    shapes[id as ShapeId] = {
+      ...node,
+      meta: {
+        ...(node.meta ?? {}),
+        ...(src.validationErrors?.length ? { validationErrors: src.validationErrors } : {}),
+        artifactRefId: src.artifactRefId ?? null,
+      },
+    };
+  }
+  return { ...result, shapes };
+}
