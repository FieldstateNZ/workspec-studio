+// S6 SPIKE DRAFT (#122) — Prototype Builder screen-element sub-selection,
+// extracted from the retired enterprise store (its `selectedElement` state
+// + addScreenElement / moveScreenElementLive / commitScreenElementMove /
+// selectElement / alignScreenElements actions, #367). The package store
+// deliberately dropped these (screen family is deferred from OSS v1), so
+// they live enterprise-side over the PUBLIC store seams:
+//
+// - sub-selection: its own tiny zustand store (it was never document
+//   state — it's view state, like the retired useCanvasHover singleton);
+// - shape mutations: pure command builders executed via the store's
+//   documented `_executeCommand` (undoable) / `_setShapesRaw` (live-drag)
+//   escape hatches — the exact same write discipline the old actions used
+//   internally.
+//
+// Consumers (ScreenShapeComponent, usePaletteDrag, useScreenElementDrag,
+// PrototypeScreensPanel) swap `useCanvasStore((s) => s.selectedElement)`
+// for `useScreenSelection()` — the only external call-site change the
+// whole shim design requires, and it is confined to the prototype family.
+
+import { createStore } from 'zustand/vanilla';
+import { useStore } from 'zustand';
+import { canvasInstance } from '@/canvas/store';
+import { snapToGrid, alignScreenEls } from '@/canvas/shapes/screen/screen-defs';
+import type { Element, ScreenShape, SelectedElement, Shape, ShapeId } from '@/canvas/types';
+
+interface ScreenSelectionState {
+  selectedElement: SelectedElement | null;
+}
+
+const screenSelectionStore = createStore<ScreenSelectionState>(() => ({
+  selectedElement: null,
+}));
+
+/** Reactive read of the placed screen element under selection. */
+export function useScreenSelection(): SelectedElement | null {
+  return useStore(screenSelectionStore, (s) => s.selectedElement);
+}
+
+/** Select (or clear) the screen element under edit. */
+export function selectElement(selection: SelectedElement | null): void {
+  screenSelectionStore.setState({ selectedElement: selection });
+}
+
+function withScreenEls(
+  shapes: Record<ShapeId, Shape>,
+  screenId: ShapeId,
+  transform: (els: Element[]) => Element[],
+): Record<ShapeId, Shape> {
+  const screen = shapes[screenId];
+  if (!screen || screen.type !== 'screen') return shapes;
+  return { ...shapes, [screenId]: { ...(screen as ScreenShape), els: transform((screen as ScreenShape).els) } };
+}
+
+/** Append `element` to `screenId`'s els (undoable). */
+export function addScreenElement(screenId: ShapeId, element: Element): void {
+  const store = canvasInstance.getState();
+  const before = store.shapes;
+  store._executeCommand({
+    label: 'Add element',
+    do: () => {
+      const s = canvasInstance.getState();
+      s._setShapesRaw(withScreenEls(s.shapes, screenId, (els) => [...els, element]));
+    },
+    undo: () => {
+      canvasInstance.getState()._setShapesRaw(before);
+    },
+  });
+}
+
+/** Raw live-drag write — no history churn; commit once at gesture end. */
+export function moveScreenElementLive(
+  screenId: ShapeId,
+  elementId: string,
+  x: number,
+  y: number,
+): void {
+  const s = canvasInstance.getState();
+  s._setShapesRaw(
+    withScreenEls(s.shapes, screenId, (els) =>
+      els.map((el) => (el.id === elementId ? { ...el, x: snapToGrid(x), y: snapToGrid(y) } : el)),
+    ),
+  );
+}
+
+/** One undoable command for a finished element-move gesture. */
+export function commitScreenElementMove(
+  screenId: ShapeId,
+  elementId: string,
+  from: { x: number; y: number },
+  to: { x: number; y: number },
+): void {
+  const store = canvasInstance.getState();
+  store._executeCommand({
+    label: 'Move element',
+    do: () => moveScreenElementLive(screenId, elementId, to.x, to.y),
+    undo: () => moveScreenElementLive(screenId, elementId, from.x, from.y),
+  });
+}
+
+/** Clean up & align (#370): snap every element on `screenId` to the grid. */
+export function alignScreenElements(screenId: ShapeId): void {
+  const store = canvasInstance.getState();
+  const before = store.shapes;
+  const screen = before[screenId];
+  if (!screen || screen.type !== 'screen' || (screen as ScreenShape).els.length === 0) return;
+  store._executeCommand({
+    label: 'Align elements',
+    do: () => {
+      const s = canvasInstance.getState();
+      s._setShapesRaw(withScreenEls(s.shapes, screenId, (els) => alignScreenEls(els)));
+    },
+    undo: () => {
+      canvasInstance.getState()._setShapesRaw(before);
+    },
+  });
+}
