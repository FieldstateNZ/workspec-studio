@@ -0,0 +1,140 @@
+// S6 SPIKE DRAFT — enterprise shape/tool registration onto the package's
+// open registries (#122, task 2). Replaces the closed module-level
+// `shapes/registry.ts` record. The whiteboard base set + C4 modules come
+// from the packages; every enterprise-only family registers on top with
+// the SAME util objects it has today (the package `ShapeUtil` is a strict
+// structural superset of the enterprise interface — verified field by
+// field against `@workspec/canvas` shape-util.ts).
+//
+// Capability mapping (replacing the enterprise chrome's hard-coded
+// per-type lists):
+//   selfRendersSelection — was SelectionLayer's opt-out list
+//     (connector/flowarrow/c4node/sticky/screen). connector+sticky ship
+//     opted-in from the package, c4node from canvas-c4; flowarrow and
+//     screen opt in HERE on their own registrations.
+//   isConnectable/connectorKey — was ConnectorTool's kind set
+//     (c4node/workflownode/diagram-node). The package keeps the legacy
+//     names as a fallback, so bare re-registration already works; we wire
+//     the capability explicitly anyway (fallbacks are a deprecation path).
+//   routedEdges/isRouteObstacle — was the router's hard-coded c4-family
+//     checks; workflownode + diagram-node opt in here.
+//   isGroupContainer/containerTitle — was the context menu's
+//     groupframe/diagram-group checks.
+//   isContextMenuSurface — c4boundary only (ships from canvas-c4).
+
+import {
+  registerWhiteboard,
+  type CanvasStoreInstance,
+  type ShapeUtil,
+} from '@workspec/canvas';
+import { registerC4 } from '@workspec/canvas-c4';
+
+// Enterprise-only utils — unchanged files, only their `ShapeUtil` import
+// now resolves to the package type (see the per-file diffs).
+import { artifactCardShapeUtil } from './shapes/artifactcard/ArtifactCardShapeUtil';
+import { atlasSuggestionShapeUtil } from './shapes/atlassuggestion/AtlasSuggestionShapeUtil';
+import { entityCardShapeUtil } from './shapes/entitycard/EntityCardShapeUtil';
+import { journeyCardShapeUtil } from './shapes/journeycard/JourneyCardShapeUtil';
+import { boardCardShapeUtil } from './shapes/boardcard/BoardCardShapeUtil';
+import { workflowNodeShapeUtil } from './shapes/workflownode/WorkflowNodeShapeUtil';
+import { diagramNodeShapeUtil } from './shapes/diagramnode/DiagramNodeShapeUtil';
+import { diagramGroupShapeUtil } from './shapes/diagramgroup/DiagramGroupShapeUtil';
+import { groupFrameShapeUtil } from './shapes/groupframe/GroupFrameShapeUtil';
+import { screenShapeUtil } from './shapes/screen/ScreenShapeUtil';
+import { deviceShapeUtil } from './shapes/device/DeviceShapeUtil';
+import { wireframeShapeUtil } from './shapes/wireframe/WireframeShapeUtil';
+import { flowArrowShapeUtil } from './shapes/flowarrow/FlowArrowShapeUtil';
+import type {
+  AtlasSuggestionShape,
+  ArtifactCardShape,
+  DiagramNodeShape,
+  DiagramGroupShape,
+  FlowArrowShape,
+  GroupFrameShape,
+  ScreenShape,
+  WorkflowNodeShape,
+} from '@/canvas/types';
+
+/**
+ * Registers everything the unified project canvas renders. Called once at
+ * module init by `@/canvas/store` on the singleton instance.
+ */
+export function registerEnterpriseCanvas(instance: CanvasStoreInstance): void {
+  // Whiteboard base (sticky/text/draw/image/connector + their tools) and
+  // the C4 layer (c4node/c4boundary with enterprise card chrome).
+  registerWhiteboard(instance);
+  registerC4(instance);
+
+  // ── Representative enterprise-only modules (task 2 of the spike) ──────
+
+  // artifactcard: plain rect card, default AABB selection (it was never in
+  // the SelectionLayer opt-out list), not connectable, not routed. The
+  // bare util registers with ZERO capability additions — the base contract
+  // covers it entirely.
+  instance.shapeUtils.registerModule<ArtifactCardShape>({
+    type: 'artifactcard',
+    util: artifactCardShapeUtil,
+  });
+
+  // atlassuggestion: ephemeral ghost card minted by useAtlasCeremony via
+  // `createShape` + `markRecent`; accept/dismiss buttons inside the
+  // Component call `deleteShapes` (host returns false → local undoable
+  // delete — the fallback contract at work). Fixed footprint, no resize,
+  // no text edit. Also fully served by the base contract.
+  instance.shapeUtils.registerModule<AtlasSuggestionShape>({
+    type: 'atlassuggestion',
+    util: atlasSuggestionShapeUtil,
+  });
+
+  // ── The rest of the enterprise families, with explicit capabilities ───
+
+  instance.shapeUtils.register(entityCardShapeUtil);
+  instance.shapeUtils.register(journeyCardShapeUtil);
+  instance.shapeUtils.register(boardCardShapeUtil);
+
+  instance.shapeUtils.register({
+    ...workflowNodeShapeUtil,
+    // ConnectorTool endpoint (was the hard-coded kind set); host-model key
+    // is the workflow state key, mirroring c4node's slug.
+    isConnectable: () => true,
+    connectorKey: (s: WorkflowNodeShape) => s.stateKey,
+    routedEdges: () => true,
+    isRouteObstacle: () => true,
+  } satisfies ShapeUtil<WorkflowNodeShape>);
+
+  instance.shapeUtils.register({
+    ...diagramNodeShapeUtil,
+    isConnectable: () => true,
+    routedEdges: () => true,
+    isRouteObstacle: () => true,
+  } satisfies ShapeUtil<DiagramNodeShape>);
+
+  instance.shapeUtils.register({
+    ...diagramGroupShapeUtil,
+    isGroupContainer: () => true,
+    containerTitle: (s: DiagramGroupShape) => s.label,
+  } satisfies ShapeUtil<DiagramGroupShape>);
+
+  instance.shapeUtils.register({
+    ...groupFrameShapeUtil,
+    isGroupContainer: () => true,
+    containerTitle: (s: GroupFrameShape) => s.title ?? 'Group',
+  } satisfies ShapeUtil<GroupFrameShape>);
+
+  // Prototype/wireframe family (deferred from OSS v1 — stays enterprise).
+  // screen + flowarrow were on the SelectionLayer opt-out list.
+  instance.shapeUtils.register({
+    ...screenShapeUtil,
+    selfRendersSelection: () => true,
+  } satisfies ShapeUtil<ScreenShape>);
+  instance.shapeUtils.register(deviceShapeUtil);
+  instance.shapeUtils.register(wireframeShapeUtil);
+  instance.shapeUtils.register({
+    ...flowArrowShapeUtil,
+    selfRendersSelection: () => true,
+  } satisfies ShapeUtil<FlowArrowShape>);
+
+  // Enterprise-only tools (FlowTool for the prototype flow arrows) would
+  // register here via `instance.tools.register(...)`; the whiteboard/C4
+  // tool set is already installed by the two register calls above.
+}
