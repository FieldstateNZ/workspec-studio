{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    // The site is a living test of the PUBLISHED packages: no `paths` override
    // and no project `references` — every @workspec/* dependency (decision-*,
    // c4-*, cost-*) resolves from its registry build (dist + shipped .d.ts) in
    // node_modules, exactly like an outside consumer, never workspace source.
    // The @workspec/cost-* packages spent one cycle as a workspace:*
    // exception (with a references block here); it was retired when the cost
    // family shipped at v0.1.0-alpha.5 — see docs/cost/drift-log.md entry 1
    // (mirroring the earlier c4 retirement at v0.1.0-alpha.2, docs/c4/drift-log.md
    // entry 17).
    "noEmit": true
  },
  "include": ["src"]
}
