{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    // The site is a living test of the PUBLISHED packages: no `paths` override
    // here, unlike the workspace packages — @workspec/* resolves from its
    // registry build (dist + .d.ts) in node_modules, never workspace source.
    "noEmit": true
  },
  "include": ["src"]
}
