{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    // The site is a living test of the PUBLISHED packages: no `paths` override
    // here, unlike the workspace packages — every @workspec/* dependency
    // resolves from its registry build (dist + .d.ts) in node_modules, never
    // workspace source, and published .d.ts need no project references. The
    // former @workspec/c4-* workspace exception (and its references block)
    // was retired when the c4 family shipped at v0.1.0-alpha.2 — see
    // docs/c4/drift-log.md entry 17.
    "noEmit": true
  },
  "include": ["src"]
}
